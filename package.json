{
  "name": "cupons",
  "version": "0.1.0",
  "private": true,
  "description": "Pipeline de ofertas/cupons com links de afiliado (Telegram + WhatsApp)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm run dev -w @cupons/api",
    "dev:worker": "npm run dev -w @cupons/worker",
    "dev:bot": "npm run dev -w @cupons/bot",
    "dev:web": "npm run dev -w @cupons/web",
    "dev:linker": "npm run dev -w @cupons/linker",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:push": "prisma db push --schema packages/db/prisma/schema.prisma",
    "db:studio": "prisma studio --schema packages/db/prisma/schema.prisma",
    "telegram:login": "npm run telegram:login -w @cupons/worker",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "ml:login": "npm run ml:login -w @cupons/linker",
    "ml:check": "npm run ml:check -w @cupons/linker --"
  },
  "devDependencies": {
    "dotenv": "^18.0.3",
    "typescript": "^5.6.0"
  }
}
