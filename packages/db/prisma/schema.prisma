// Schema Prisma do pipeline de ofertas.
// Multi-tenant já previsto via `tenantId` nullable em Product (fase SaaS).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id             String    @id @default(cuid())
  store          String
  storeProductId String
  title          String
  price          Decimal   @db.Decimal(10, 2)
  oldPrice       Decimal?  @db.Decimal(10, 2)
  discountPct    Int?
  coupon         String?
  imageUrl       String?
  category       String?   // slug de @cupons/shared CATEGORIES (palpite automático, admin pode trocar)
  rating         Decimal?  @db.Decimal(3, 2)
  sales          Int?
  url            String
  status         String    @default("NEW")
  tenantId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  posts          Post[]
  suggestions    Suggestion[]
  priceHistory   PriceSnapshot[]

  @@unique([tenantId, store, storeProductId])
  @@index([status])
  @@index([store])
  @@index([createdAt])
}

model Post {
  id                 String   @id @default(cuid())
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId          String
  channel            Channel? @relation(fields: [channelId], references: [id])
  channelId          String?
  platform           String   @default("TELEGRAM")
  message            String
  affiliateUrl       String
  subId              String?
  status             String   @default("SCHEDULED")
  /// Ordem na fila: nota da oferta (0-100); agendado à mão = 100. A fila sai da maior para a menor.
  priority           Int      @default(50)
  /// Preço anunciado na mensagem (conferido na loja antes de enviar)
  price              Decimal? @db.Decimal(10, 2)
  /// Falhas seguidas ao conferir o preço (API fora do ar); desiste na 3ª
  checkErrors        Int      @default(0)
  /// Espelhamento: horário reservado do envio (job atrasado). POSTING com sendAt no futuro = esperando a vez,
  /// não "enviando" (não trava a fila nem vira "Envio interrompido").
  sendAt             DateTime?
  telegramMessageId  Int?
  lastError          String?
  postedAt           DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  clicks             Click[]

  @@index([status])
  @@index([postedAt])
  @@index([createdAt])
  @@index([channelId, status, priority])
}

model Click {
  id        String   @id @default(cuid())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  referrer  String?
  createdAt DateTime @default(now())

  @@index([postId])
  @@index([createdAt])
}

// Destino de publicação (um canal do Telegram, um grupo/canal do WhatsApp...), com o
// próprio ritmo: WhatsApp (API não oficial) precisa de limites bem mais rígidos que o Telegram.
model Channel {
  id           String   @id @default(cuid())
  platform     String   // TELEGRAM | WHATSAPP
  name         String
  target       String   // Telegram: @canal ou id numérico. WhatsApp: JID (...@g.us grupo, ...@newsletter canal)
  enabled      Boolean  @default(true)
  postsPerHour Int      @default(3)
  postsPerDay  Int      @default(0)  // 0 = sem teto
  quietHours   String   @default("") // ex.: "23-7" (horário de Brasília)
  jitterPct    Int      @default(0)  // variação aleatória do intervalo, em %: evita padrão robótico
  warmupDays   Int      @default(0)  // rampa de volume p/ número novo (0 = sem rampa)
  categories   String[] @default([]) // categorias que recebe (vazio = recebe tudo: grupo "geral")
  generalMinScore Int   @default(80) // canal geral: só recebe ofertas garimpadas p/ nichos com nota >= isto
  /// Canal geral ("variedades"): oferta de uma categoria que tem grupo próprio vai só para esse grupo, e o
  /// geral não recebe o repasse dos nichos (generalMinScore deixa de valer). Pedido em 2026-09-26.
  routeNiche      Boolean   @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  posts        Post[]
  sources      ChannelSource[]
  suggestions  Suggestion[]

  @@unique([platform, target])
}

model AppConfig {
  key   String @id
  value String
}

// Preço visto a cada coleta/preview: base para detectar desconto falso.
model PriceSnapshot {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

// Produto que a curadoria (regras ou IA) sugeriu postar. Aprovada → vira Post.
model Suggestion {
  id         String    @id @default(cuid())
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  source     String    // AMAZON_MANUAL | SHOPEE_API | ALIEXPRESS_API
  curator    String    // "rules" ou "claude:<modelo>"
  score      Int       // 0-100
  reason     String    // por que foi escolhido (para o admin decidir)
  hook       String?   // frase de chamada escrita pela IA (sem números)
  status     String    @default("PENDING") // PENDING | APPROVED | REJECTED
  postId     String?
  decidedBy  AdminUser? @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  decidedById String?
  channel    Channel?  @relation(fields: [channelId], references: [id], onDelete: SetNull) // destino (fonte do canal)
  channelId  String?
  origin     ChannelSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull) // fonte que achou
  sourceId   String?
  createdAt  DateTime  @default(now())
  decidedAt  DateTime?

  @@index([status, createdAt])
  @@index([productId])
}


// ---------------------------------------------------------------- acesso ao painel

// Uma conta por pessoa. Perfis: DEV (tudo, inclusive usuários) | GERENTE (operação).
model AdminUser {
  id                 String         @id @default(cuid())
  name               String
  email              String         @unique // sempre minúsculo
  passwordHash       String         // scrypt$N$r$p$sal$hash
  role               String         @default("GERENTE")
  active             Boolean        @default(true)
  mustChangePassword Boolean        @default(false) // senha provisória: troca obrigatória
  failedLogins       Int            @default(0)
  lockedUntil        DateTime?      // bloqueio após muitas senhas erradas
  lastLoginAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  sessions           AdminSession[]
  audit              AuditLog[]
  decisions          Suggestion[]
}

// Sessão no servidor: o navegador guarda o token; aqui fica só o SHA-256 dele.
model AdminSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime  // limite absoluto
  revokedAt  DateTime?
  ip         String?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
}

// Quem fez o quê no painel.
model AuditLog {
  id        String     @id @default(cuid())
  user      AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  action    String     // ex.: login, login_failed, post.publish_now, user.create
  target    String?    // id do objeto afetado
  detail    String?    // resumo legível
  ip        String?
  createdAt DateTime   @default(now())

  @@index([createdAt])
  @@index([userId])
}


// De onde vêm as promoções de um canal: APIs oficiais das lojas ou outros grupos/canais do Telegram.
model ChannelSource {
  id            String    @id @default(cuid())
  channel       Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId     String
  kind          String    // API | TELEGRAM | MIRROR (espelha grupo, cofre/10) | COUPONS (coleta cupons de um grupo, cofre/11)
  label         String
  enabled       Boolean   @default(true)
  stores        String[]  @default([]) // API: ALIEXPRESS, SHOPEE, AMAZON
  keywords      String[]  @default([]) // termos de busca (API) / termos que o título deve ter (filtro)
  promos        String[]  @default([]) // promoções em destaque do AliExpress (trechos do nome)
  telegramChat  String?   // TELEGRAM/MIRROR: @canal ou id do grupo observado
  lastMessageId BigInt?   // TELEGRAM/MIRROR: última mensagem lida
  /// MIRROR: nome do grupo observado, preenchido pelo worker ao conectar (mostrado no painel)
  chatTitle     String?
  /// MIRROR: tipos de link convertidos (MERCADOLIVRE); o resto da mensagem é ignorado
  linkTypes     String[]  @default([])
  /// MIRROR: atraso aleatório de 0 até isto (segundos) contado da mensagem original
  maxDelaySec   Int       @default(150)
  /// MIRROR: não posta durante o silêncio de madrugada do canal
  respectQuiet  Boolean   @default(true)
  /// MIRROR/COUPONS: intervalo mínimo entre posts no canal (grupo manda 5 de uma vez → saem espaçados)
  minGapSec     Int       @default(180)
  /// COUPONS: publica cada cupom novo (válido) neste canal; desligado = só guarda no painel
  postCoupons   Boolean   @default(false)
  /// Alerta para o painel (ex.: conversão do link falhou). Fica até alguém dispensar.
  alert         String?
  alertAt       DateTime?
  alertCount    Int       @default(0)
  minDiscount   Int       @default(0)
  minRating     Decimal?  @db.Decimal(3, 2)
  minPrice      Decimal?  @db.Decimal(10, 2)
  maxPrice      Decimal?  @db.Decimal(10, 2)
  excludeWords  String[]  @default([])
  maxPerRun     Int       @default(5)
  intervalMin   Int       @default(120)
  /// Aprova sozinho as sugestões desta fonte com nota >= autoMinScore (sem passar pela aba Sugestões)
  autoApprove   Boolean   @default(false)
  autoMinScore  Int       @default(70)
  lastRunAt     DateTime?
  lastResult    String?   // resumo ou erro da última rodada
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  suggestions   Suggestion[]
  seenLinks     SeenLink[]
  events        SourceEvent[]
  coupons       Coupon[]

  @@index([channelId])
}

// Histórico do espelhamento: cada mensagem do grupo observado que tinha link tratável.
model SourceEvent {
  id           String        @id @default(cuid())
  source       ChannelSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId     String
  messageId    BigInt?
  /// link como veio na mensagem (ex.: https://meli.la/abc)
  link         String
  linkType     String
  /// URL do produto sem query/hash e o nosso link de afiliado gerado
  productUrl   String?
  affiliateUrl String?
  /// cupom lido da mensagem (código em monoespaçado/"Cupom: X" ou cupom de página "20% OFF"); vai no nosso post
  coupon       String?
  /// PENDING (na fila do conversor) | CONVERTED (post criado) | FAILED | SKIPPED
  status       String        @default("PENDING")
  detail       String?
  postId       String?
  /// quando o post deve sair (mensagem original + atraso aleatório)
  postAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([sourceId, createdAt])
  @@index([status])
}

// Link já visto numa fonte do Telegram: não reprocessa.
model SeenLink {
  id        String        @id @default(cuid())
  urlHash   String        @unique
  source    ChannelSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId  String
  /// URL canônica do produto (para tentar de novo quando a loja falhou)
  url       String?
  /// DONE = já decidido (sugerido, fora do nicho, loja sem integração); RETRY = falha passageira
  status    String        @default("DONE")
  attempts  Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt

  @@index([sourceId, status])
}

// Cupom coletado de um grupo de cupons (cofre/11). Um por loja+código; visto de novo → atualiza.
model Coupon {
  id            String         @id @default(cuid())
  /// MERCADOLIVRE | AMAZON | SHOPEE | ALIEXPRESS
  store         String
  code          String
  /// resumo nosso ("15% OFF acima de R$ 799 (máx. R$ 130)") ou o título do ML ao validar ("10% OFF TODO O SITE")
  title         String
  discountPct   Int?
  discountValue Decimal?       @db.Decimal(10, 2)
  minPurchase   Decimal?       @db.Decimal(10, 2)
  maxDiscount   Decimal?       @db.Decimal(10, 2)
  /// parte da loja em que vale ("Decoração & Eletros", "Em produtos de X")
  scope         String?
  /// vale para a loja toda → pode ir junto dos posts de produto da loja (ajustável no painel)
  attachable    Boolean        @default(false)
  /// NEW (ainda não testado) | VALID | RESTRICTED ("não se aplica a você") | INVALID | EXPIRED
  status        String         @default("NEW")
  statusDetail  String?
  checkedAt     DateTime?
  expiresAt     DateTime?
  /// link que veio com o cupom (é do afiliado que postou: só referência no painel, NUNCA vai para os nossos posts)
  sourceLink    String?
  source        ChannelSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourceId      String?
  messageId     BigInt?
  seenCount     Int            @default(1)
  firstSeenAt   DateTime       @default(now())
  lastSeenAt    DateTime       @default(now())
  /// publicação no canal de cupons: horário reservado e quando saiu
  postAt        DateTime?
  postedAt      DateTime?
  postError     String?
  /// quantos posts de produto levaram este cupom
  usedInPosts   Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([store, code])
  @@index([status, store])
  @@index([expiresAt])
}

