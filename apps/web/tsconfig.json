{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./*"],
      "@cupons/shared": ["../../packages/shared/src/index.ts"],
      "@cupons/affiliates": ["../../packages/affiliates/src/index.ts"],
      "@cupons/db": ["../../packages/db/src/index.ts"]
    },
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "incremental": true,
    "allowJs": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}