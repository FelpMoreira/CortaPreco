# ============================================================
# CUPONS — variáveis de ambiente
# Copie para .env e preencha os valores reais.
# ============================================================

# ---- Banco / Fila ------------------------------------------
DATABASE_URL="postgresql://cupons:cupons@localhost:5434/cupons?schema=public"
REDIS_URL="redis://localhost:6379"

# ---- API ----------------------------------------------------
API_PORT=3001
API_HOST="0.0.0.0"
# true quando a API estiver atrás de proxy/túnel (nginx, cloudflared, Caddy). Sem isso o rate
# limit enxerga todo mundo com o IP do proxy e bloqueia geral. NUNCA true exposto direto.
TRUST_PROXY=false
PUBLIC_BASE_URL=""                   # domínio público da API (ex.: https://ofertas.seudominio.com.br). Vazio = posts usam o link de afiliado direto (sem contar cliques)
# Chave que o painel usa para chamar a API (Bearer token). 32+ caracteres: openssl rand -hex 32
ADMIN_API_KEY="troque-por-uma-chave-forte"

# ---- Painel/Web (Next.js) -----------------------------------
WEB_PORT=3000
# Senha do painel admin (login por cookie) — troque!
ADMIN_PASSWORD="troque-a-senha"
JWT_SECRET="troque-por-segredo-jwt-aleatorio"   # 32+ caracteres: openssl rand -hex 32
NEXT_PUBLIC_API_URL="http://localhost:3001"
# Link de convite do canal, mostrado no site público (ex.: https://t.me/meucanaldeofertas)
NEXT_PUBLIC_TELEGRAM_URL=""

# ---- Telegram ------------------------------------------------
TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."
# @username do canal de ofertas (colocar o bot como admin)
TELEGRAM_CHANNEL="@meucanaldeofertas"
# Chat IDs (numéricos) com acesso aos comandos admin do bot, separados por vírgula
TELEGRAM_ADMIN_IDS="123456789"
# Limites do agendador
POSTS_PER_DAY=0                # teto em janela móvel de 24h; 0 = sem teto (Telegram só limita velocidade)
POSTS_PER_HOUR=3
QUIET_HOURS="23-7"            # sem posts automáticos nesse horário (Brasília); "postar agora" ignora

# ---- Shopee (open-api.affiliate.shopee.com.br) ---------------
SHOPEE_APP_ID=""
SHOPEE_APP_SECRET=""
SHOPEE_SUB_ID="cupons"          # tracking interno p/ relatório de conversão

# ---- AliExpress (Open Platform / TOP API) --------------------
ALIEXPRESS_APP_KEY=""
ALIEXPRESS_APP_SECRET=""
ALIEXPRESS_TRACKING_ID=""       # PID criado no Portals

# ---- Amazon ---------------------------------------------------
# Partner Tag (Store ID) — obrigatório para qualquer link de afiliado
AMAZON_PARTNER_TAG="seudominio-20"
AMAZON_MARKETPLACE="www.amazon.com.br"
# Creators API (antiga PA-API 5) — SÓ se sua conta tiver 10 vendas qualificadas nos
# últimos 30 dias. Sem isso o coletor usa scrape leve da página + tag manual.
AMAZON_ACCESS_KEY=""
AMAZON_SECRET_KEY=""
AMAZON_PARTNER_TYPE="Associates"
AMAZON_REGION="us-east-1"
# Host/endpoint Creators API (ex.: webservices.amazon.com.br). Deixe vazio p/ usar fallback.
AMAZON_API_HOST=""
# ---- Curadoria (IA) --------------------------------------------
# rules = só regras, sem custo (padrão) | claude = Claude escolhe e escreve a chamada
LLM_PROVIDER="rules"
LLM_MODEL="claude-opus-5"
# ANTHROPIC_API_KEY=""          # necessário com LLM_PROVIDER=claude
CURATION_MAX_PICKS=5            # sugestões por rodada
CURATION_COOLDOWN_DAYS=7        # não sugere o que foi postado nos últimos N dias
# Descoberta automática pelas APIs oficiais (Shopee/AliExpress; Amazon só via Creators API)
DISCOVERY_ENABLED=false
DISCOVERY_INTERVAL_MIN=120
DISCOVERY_MIN_DISCOUNT=15       # % mínimo de desconto para virar candidato
DISCOVERY_LIMIT=30              # produtos por rede em cada busca
