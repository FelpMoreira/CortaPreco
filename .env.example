# ============================================================
# CUPONS — variáveis de ambiente
# Copie para .env e preencha os valores reais.
# ============================================================

# ---- Banco / Fila ------------------------------------------
DATABASE_URL="postgresql://cupons:cupons@localhost:5434/cupons?schema=public"
REDIS_URL="redis://localhost:6379"

# ---- API ----------------------------------------------------
API_PORT=3001
API_HOST="0.0.0.0"
# true quando a API estiver atrás de proxy/túnel (nginx, cloudflared, Caddy). Sem isso o rate
# limit enxerga todo mundo com o IP do proxy e bloqueia geral. NUNCA true exposto direto.
TRUST_PROXY=false
# Painel (Next): quantos proxies confiáveis ficam na frente dele (Caddy/nginx = 1). Define qual IP do
# X-Forwarded-For vale para o limite de tentativas de login. Em produção o painel deve ficar atrás de proxy.
TRUST_PROXY_HOPS=0
PUBLIC_BASE_URL=""                   # domínio público da API (ex.: https://ofertas.seudominio.com.br). Vazio = posts usam o link de afiliado direto (sem contar cliques)
# Chave que o painel usa para chamar a API (Bearer token). 32+ caracteres: openssl rand -hex 32
ADMIN_API_KEY="troque-por-uma-chave-forte"

# ---- Painel/Web (Next.js) -----------------------------------
WEB_PORT=3000
# Login do painel é por usuário (tabela AdminUser, perfis DEV/GERENTE). ADMIN_PASSWORD só serve
# para confirmar o "primeiro acesso" (criar o 1º DEV pela tela de login) enquanto não há usuários.
# Alternativa: npm run admin:create -w @cupons/api -- --email voce@x.com --name "Nome" --role DEV
ADMIN_PASSWORD="troque-a-senha"
NEXT_PUBLIC_API_URL="http://localhost:3001"
# Link de convite do canal, mostrado no site público (ex.: https://t.me/meucanaldeofertas)
NEXT_PUBLIC_TELEGRAM_URL=""

# ---- Telegram ------------------------------------------------
TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."
# @username do canal de ofertas (colocar o bot como admin)
TELEGRAM_CHANNEL="@meucanaldeofertas"
# Chat IDs (numéricos) com acesso aos comandos admin do bot, separados por vírgula
TELEGRAM_ADMIN_IDS="123456789"
# Limites do agendador
POSTS_PER_DAY=0                # teto em janela móvel de 24h; 0 = sem teto (Telegram só limita velocidade)
POSTS_PER_HOUR=3
QUIET_HOURS="23-7"            # sem posts automáticos nesse horário (Brasília); "postar agora" ignora

# ---- Leitura de OUTROS grupos/canais do Telegram (fontes de ofertas) ----
# Bot não lê canais de terceiros: usa uma CONTA DE USUÁRIO DEDICADA (não o número pessoal), só leitura.
# 1) my.telegram.org → API development tools → API_ID e API_HASH
# 2) docker compose exec -it worker npm run telegram:login  → gera TELEGRAM_USER_SESSION (trate como senha)
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
TELEGRAM_USER_SESSION=""

# ---- WhatsApp (Evolution API — NÃO oficial) ----------------------
# A API oficial não serve (grupos de no máx. 8 pessoas, sem canais). A Evolution usa o
# WhatsApp Web: viola os Termos e o número PODE SER BANIDO. Use chip dedicado e aquecido,
# nunca o número pessoal. Cada post aprovado sai no Telegram E no WhatsApp, cada um no seu ritmo.
WHATSAPP_ENABLED=false
WHATSAPP_TARGET=""              # JID do destino: grupo "1203...@g.us" ou canal "1203...@newsletter"
EVOLUTION_API_URL=""            # ex.: http://localhost:8080
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE=""           # nome da instância conectada ao número
# Ritmo (padrões conservadores; não existe limite "seguro" oficial)
WHATSAPP_POSTS_PER_HOUR=2
WHATSAPP_POSTS_PER_DAY=15       # teto; em aquecimento sobe aos poucos até ele
WHATSAPP_QUIET_HOURS="22-8"
WHATSAPP_JITTER_PCT=35          # variação aleatória do intervalo (evita padrão de robô)
WHATSAPP_WARMUP_DAYS=14         # rampa de volume para número novo (0 = sem rampa)

# ---- Shopee (open-api.affiliate.shopee.com.br) ---------------
SHOPEE_APP_ID=""
SHOPEE_APP_SECRET=""
SHOPEE_SUB_ID="cupons"          # tracking interno p/ relatório de conversão

# ---- AliExpress (Open Platform / TOP API) --------------------
ALIEXPRESS_APP_KEY=""
ALIEXPRESS_APP_SECRET=""
ALIEXPRESS_TRACKING_ID=""       # PID criado no Portals
# Termos da descoberta automática, separados por vírgula (vazio = categorias populares padrão)
ALIEXPRESS_KEYWORDS=""
# Promoções em destaque do AliExpress a usar (trechos do nome, separados por vírgula).
# Vazio = automático: as do Brasil (ex.: "Ship From BR") + eventos do site (Brand Day, Super Deals...)
ALIEXPRESS_PROMOS=""

# ---- Amazon ---------------------------------------------------
# Partner Tag (Store ID) — obrigatório para qualquer link de afiliado
AMAZON_PARTNER_TAG="seudominio-20"
AMAZON_MARKETPLACE="www.amazon.com.br"
# Creators API (antiga PA-API 5) — SÓ se sua conta tiver 10 vendas qualificadas nos
# últimos 30 dias. Sem isso o coletor usa scrape leve da página + tag manual.
AMAZON_ACCESS_KEY=""
AMAZON_SECRET_KEY=""
AMAZON_PARTNER_TYPE="Associates"
AMAZON_REGION="us-east-1"
# Host/endpoint Creators API (ex.: webservices.amazon.com.br). Deixe vazio p/ usar fallback.
AMAZON_API_HOST=""
# ---- Curadoria (IA) --------------------------------------------
# rules = só regras, sem custo (padrão) | claude = Claude escolhe e escreve a chamada
LLM_PROVIDER="rules"
LLM_MODEL="claude-opus-5"
# ANTHROPIC_API_KEY=""          # necessário com LLM_PROVIDER=claude
CURATION_MAX_PICKS=5            # sugestões por rodada
CURATION_COOLDOWN_DAYS=7        # não sugere o que foi postado nos últimos N dias
# Descoberta automática pelas APIs oficiais (Shopee/AliExpress; Amazon só via Creators API)
DISCOVERY_ENABLED=false
DISCOVERY_INTERVAL_MIN=120
DISCOVERY_MIN_DISCOUNT=15       # % mínimo de desconto para virar candidato
DISCOVERY_LIMIT=30              # produtos por rede em cada busca
